@using Infrastructure.ViewModels
@model IEnumerable<ProcedureViewModel>

@{
    ViewData["Title"] = "Начало";
}

<head>
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<div class="text-center">
    <h2 class="mt-4">Създай нова процедура</h2>

    <!-- FORM to send parameters to CreateProcedure -->
    <form asp-controller="Home" asp-action="CreateProcedure" method="post" class="mt-3">

        <div class="form-group mb-3">
            <label for="ProcedureType">Тип процедура:</label>
            <input type="text" id="ProcedureType" name="ProcedureType" class="form-control text-center" placeholder="Въведете тип процедура" required />
        </div>

        <div class="form-group mb-3">
            <label for="Field">Научна област::</label>
            <input type="text" id="Field" name="Field" class="form-control text-center" placeholder="Въведете поле" required />
        </div>

        <div class="form-group mb-3">
            <label for="Date">Дата:</label>
            <input type="date" id="Date" name="Date" class="form-control text-center"
                   value="@Model?.FirstOrDefault()?.Procedure.Date?.ToString("yyyy-MM-dd")" required />
            <small class="text-muted">Формат: ден/месец/година</small>
        </div>

        <button type="submit" class="btn btn-success">Създай процедура</button>
    </form>

    <div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive mt-5">
                <table class="table table-bordered table-hover styled-table align-middle text-center">
                    <thead class="table-header text-white">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Procedure Type</th>
                            <th scope="col">Date</th>
                            <th scope="col">Professors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Procedure.Id</td>
                                <td>@item.Procedure.ProcedureType</td>
                                <td>@item.Procedure.Date?.ToString("dd-MM-yyyy")</td>
                                <td>
                                    @if (item.Professors != null && item.Professors.Any())
                                    {
                                        @for (int i = 0; i < item.Professors.Count; i++)
                                        {
                                            if (i == item.Professors.Count - 1 || i == item.Professors.Count - 2)
                                            {
                                                <div>@item.Professors[i].AcademicRank @(item.Professors[i].FullName) ("Резерва")</div>
                                            }
                                            else
                                            {
                                                <div>@item.Professors[i].AcademicRank @item.Professors[i].FullName</div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <h3 class="mt-5">Няма създадени процедури</h3>
        }
    </div>
</div>